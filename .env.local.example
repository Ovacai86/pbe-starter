# Copia este archivo como .env.local y completa los valores durante el curso.
#   cp .env.local.example .env.local

# En Supabase: Project Settings → API Keys (pestaña "Publishable and secret API keys")
# La publishable key (sb_publishable_...) es segura para usar en el navegador.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
